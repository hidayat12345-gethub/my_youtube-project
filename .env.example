# ============================================================
# HOLY MONTH AI — environment configuration
# ============================================================
# Copy this file to .env and fill in real values. .env is gitignored —
# never commit it. Every value below is empty/example only; nothing
# here is a real credential.

# ---- Gemini (free tier) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- YouTube OAuth (free) ----
# Create an OAuth Client ID (Desktop app) at
# https://console.cloud.google.com/apis/credentials, then run:
#   python holy_month_automation.py youtube-auth
# which fills in YOUTUBE_REFRESH_TOKEN automatically.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---- Telegram Bot (free) ----
# Create a bot via @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Human review gate ----
# Videos upload UNLISTED and wait for approval before going public.
REQUIRE_HUMAN_REVIEW=true
# If a pending_review video hasn't been manually approved within this
# many hours, it's auto-published so the daily cadence never silently
# stalls. Set to 0 to disable.
AUTO_APPROVE_AFTER_HOURS=20

# ---- Scheduling ----
# Hour (0-23, server local time) the daily scheduler checks whether
# it's time to produce the next video in each active plan.
PUBLISH_HOUR=8
SCHEDULER_CHECK_INTERVAL_MINUTES=15

# ---- System ----
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-value
DATABASE_URL=sqlite:///./holy_month.db

# ---- Security (audit) ----
# Comma-separated list of origins the FastAPI backend accepts CORS
# requests from. Defaults to localhost Streamlit ports if unset —
# only change this if your dashboard runs somewhere else.
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Opt-in shared-secret protection for mutating/destructive API
# endpoints (approve/reject/delete/regenerate/restore-db/etc).
# Leave EMPTY for local/dev use — no auth required, unchanged behavior.
# Set a long random value if this backend is ever reachable from
# anywhere other than your own machine (a home server, a tunnel, a
# VPS). If set, also set HOLY_MONTH_API_KEY (same value) in the
# environment the DASHBOARD runs in — see dashboard/README.md.
API_ACCESS_TOKEN=
