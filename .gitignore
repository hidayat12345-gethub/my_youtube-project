# Secrets — never commit these
.env

# Database — the GitHub Actions workflow commits this back deliberately;
# if you're NOT using that workflow, uncomment the next line:
# holy_month.db

# Generated video output (large binary files — regenerated by the pipeline)
output_videos/

# Logs (Module 6) — local-only, not meant to be versioned
logs/

# DB backups/snapshots (Module 6 System Settings)
backups/

# Settings/prompt overrides (Module 6) — created lazily with defaults;
# commit these if you WANT your customizations versioned, otherwise ignore
holy_month_settings.json
holy_month_prompt_templates.json

# Python
__pycache__/
*.pyc
*.pyo
.Python
*.egg-info/
.venv/
venv/

# Testing (audit)
.pytest_cache/
.coverage
htmlcov/

# Streamlit
.streamlit/secrets.toml

# OS/editor cruft
.DS_Store
.vscode/
*.swp
